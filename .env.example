# PPAI Bot — Variables de entorno
# Copia este archivo a .env y completa los valores
# El archivo .env NUNCA se commitea a git

# ---------------------------------------------------------------------------
# REQUERIDO
# ---------------------------------------------------------------------------

# Token del bot de Telegram (obtenido de @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# ---------------------------------------------------------------------------
# LOCAL (LocalStack) — descomenta para desarrollo local
# ---------------------------------------------------------------------------

# Endpoint de LocalStack (DynamoDB local)
# DYNAMODB_ENDPOINT_URL=http://localhost:4566

# Región AWS (LocalStack acepta cualquier valor)
# AWS_REGION=us-east-1

# Credenciales dummy para LocalStack (no usa credenciales reales)
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# ---------------------------------------------------------------------------
# PRODUCCIÓN (AWS) — valores reales, no descomentar en local
# ---------------------------------------------------------------------------

# AWS_REGION=us-east-1
# DYNAMODB_TABLE_PREFIX=ppai
# ACTIVE_TASK_LIMIT=50
# DEDUP_WINDOW_SECONDS=300
# RATE_LIMIT_PER_MINUTE=10

# ---------------------------------------------------------------------------
# OPCIONALES (tienen defaults razonables)
# ---------------------------------------------------------------------------

# DYNAMODB_TABLE_PREFIX=ppai
# ACTIVE_TASK_LIMIT=50
# DEDUP_WINDOW_SECONDS=300
# RATE_LIMIT_PER_MINUTE=10
